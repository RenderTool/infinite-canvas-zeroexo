{
  "name": "@zeroexo/canvas-agent",
  "version": "0.1.0",
  "type": "module",
  "description": "ZeroExo 画布 MCP Agent：让外部 AI 客户端（Codex/Claude Code/Cursor）经标准 MCP 协议操作 ZeroExo 网页画布",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "zeroexo-canvas-agent": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:mcp": "tsx src/index.ts mcp",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^5.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18"
  }
}
