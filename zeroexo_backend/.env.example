# ============ 数据库 (PostgreSQL) ============
DATABASE_URL="postgresql://zeroexo:zeroexo@localhost:5432/zeroexo?schema=public"

# ============ Redis (会话锁/多实例同步,可选) ============
# 留空则降级为内存模式(单实例/本地开发适用)
REDIS_URL=""

# ============ JWT ============
JWT_SECRET="change-me-in-production-please-use-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ============ MinIO 对象存储 ============
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="zeroexo-assets"

# ============ 服务 ============
PORT=3000
# 反向代理信任层数(反代部署时设为 1,使限流/日志取到真实客户端 IP)
TRUST_PROXY=1

# ============ 前端 CORS ============
# 逗号分隔的允许来源列表
CORS_ORIGINS="http://localhost:5180,http://localhost:8080"

# ============ AI 对接 (P3) ============
# API Key 加密密钥(AES-256-GCM,32 字节 hex;生产环境务必更换)
# 生成方式: openssl rand -hex 32 (或 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# 注意: 请勿使用占位符/全零值,未配置时后端会在实际加密/解密 API Key 时拒绝执行
AI_ENCRYPTION_KEY="please-generate-32-byte-hex-key"
# 生成请求超时(毫秒)
AI_REQUEST_TIMEOUT_MS="60000"
# 服务端默认凭据(可选,未配置用户级 provider 时兜底,适合 demo)
AI_OPENAI_API_KEY=""
AI_OPENAI_BASE_URL="https://api.openai.com/v1"
AI_GEMINI_API_KEY=""
AI_GEMINI_BASE_URL="https://generativelanguage.googleapis.com"
AI_STABILITY_API_KEY=""
AI_STABILITY_BASE_URL="https://api.stability.ai/v2beta/stable-image"
AI_VOLCENGINE_API_KEY=""
AI_VOLCENGINE_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"

# ============ 限流 (Stage H.1) ============
# 限流白名单(逗号分隔,支持 IP / 段前缀 / CIDR)
# 注意: 不再默认放行内网 IP(反代部署下会导致限流失效),内网信任请显式配置
# 示例:"127.0.0.1,192.168.1.10,10.0.0.0/8"
THROTTLE_WHITELIST=""
