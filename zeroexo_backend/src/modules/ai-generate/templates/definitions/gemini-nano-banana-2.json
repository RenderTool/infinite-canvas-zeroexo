{
  "id": "gemini-nano-banana-2",
  "name": "Nano Banana 2 (Gemini 3.1 Flash Image)",
  "protocol": "gemini",
  "modelType": "image",
  "endpoint": "/v1beta/models/{model}:generateContent",
