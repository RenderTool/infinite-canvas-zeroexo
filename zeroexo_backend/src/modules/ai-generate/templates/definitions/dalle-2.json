{
  "id": "dall-e-2",
  "name": "DALL·E 2",
  "protocol": "openai",
  "modelType": "image",
  "endpoint": "/images/generations",
  "maxPromptLength": 1000,
  "parameters": [
    {
      "name": "resolution",
      "type": "enum",
      "label": "分辨率",
      "default": "1024",
      "values": [
        "256",
        "512",
        "1024"
      ],
      "labels": {
        "256": "256",
        "512": "512",
        "1024": "1024"
      },
      "display": "radio"
    },
    {
      "name": "n",
      "type": "number",
      "label": "生成数量",
      "default": 1,
      "min": 1,
      "max": 10,
      "step": 1,
      "advanced": true
    },
    {
      "name": "watermark",
      "type": "boolean",
      "label": "水印",
      "default": false
    },
    {
      "name": "referenceImagesEnabled",
      "type": "boolean",
      "label": "参考图片",
      "default": false
    },
    {
      "name": "maxReferenceImages",
      "type": "number",
      "label": "最大参考图片数",
      "default": 0
    },
    {
      "name": "imageFormat",
      "type": "enum",
      "label": "图片格式",
      "default": "jpeg",
      "values": [
        "png",
        "jpeg"
      ],
      "labels": {
        "png": "PNG",
        "jpeg": "JPEG"
      },
      "display": "select",
      "advanced": true
    }
  ],
  "channelConstraints": {
    "bounds": {
      "minTotalPixels": 65536,
      "maxTotalPixels": 1048576,
      "minAspectRatio": 1,
      "maxAspectRatio": 1,
      "maxReferenceImages": 0,
      "supportsImageToImage": false,
      "maxEdgeLength": 1024
    },
    "paramMapping": {
      "n": "n"
    },
    "valueMapping": {
      "resolution": {
        "256": "256x256",
        "512": "512x512",
        "1024": "1024x1024"
      }
    }
  },
  "pricing": {
    "perImage": 0.02
  },
  "matchKeywords": [
    "dall-e-2",
    "dalle-2"
  ]
}
