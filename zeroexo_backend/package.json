{
  "name": "zeroexo-server",
  "version": "1.1.0",
  "private": true,
  "description": "ZeroExo 后端服务 - NestJS + Prisma + PostgreSQL + MinIO(独立工程)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "set CHECKPOINT_DISABLE=1 && prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "local:seed": "ts-node prisma/local-seed.ts",
    "cleanup:orphans": "ts-node prisma/cleanup-orphan-assets.ts",
    "cleanup:orphans:confirm": "ts-node prisma/cleanup-orphan-assets.ts --confirm",
    "redis:start": "docker run -d --name zeroexo-redis -p 6379:6379 redis:7-alpine",
    "redis:stop": "docker stop zeroexo-redis && docker rm zeroexo-redis",
    "minio:start": "docker run -d --name zeroexo-minio -p 9000:9000 -p 9001:9001 -e MINIO_ROOT_USER=minioadmin -e MINIO_ROOT_PASSWORD=minioadmin minio/minio:latest server /data --console-address \":9001\"",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "@hocuspocus/server": "^4.4.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/throttler": "^6.5.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/client": "^5.18.0",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cron": "^4.4.0",
    "dayjs": "^1.11.21",
    "express": "^4.21.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "minio": "^8.0.4",
    "nanoid": "^6.0.0",
    "nodemailer": "^9.0.3",
    "openai": "^4.77.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^5.18.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
