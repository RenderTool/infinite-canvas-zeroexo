{
  "name": "@zeroexo/app-canvas",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "ZeroExo Canvas - Visual node editor",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "turbo run test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "turbo run clean && rimraf node_modules",
    "build:core": "pnpm --filter @zeroexo/core build",
    "test:core": "pnpm --filter @zeroexo/core test"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@hocuspocus/provider": "^4.4.0",
    "@lobehub/icons": "^5.14.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.2",
    "@uiw/react-md-editor": "^4.1.1",
    "@zeroexo/core": "workspace:*",
    "@zeroexo/plugin-ai-provider": "workspace:*",
    "@zeroexo/plugin-connection": "workspace:*",
    "@zeroexo/plugin-group": "workspace:*",
    "@zeroexo/plugin-history": "workspace:*",
    "@zeroexo/plugin-image-editor": "workspace:*",
    "@zeroexo/plugin-interaction": "workspace:*",
    "@zeroexo/plugin-keyboard": "workspace:*",
    "@zeroexo/plugin-layout": "workspace:*",
    "@zeroexo/plugin-minimap": "workspace:*",
    "@zeroexo/plugin-node-registry": "workspace:*",
    "@zeroexo/plugin-nodes": "workspace:*",
    "@zeroexo/plugin-persistence": "workspace:*",
    "@zeroexo/plugin-render-react": "workspace:*",
    "@zeroexo/plugin-selection": "workspace:*",
    "@zeroexo/plugin-theme": "workspace:*",
    "@zeroexo/plugin-upload-queue": "workspace:*",
    "@zeroexo/preset-default": "workspace:*",
    "@zeroexo/shared": "workspace:*",
    "antd": "^6.5.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.2.4",
    "fflate": "^0.8.3",
    "i18next": "^26.3.4",
    "jszip": "^3.10.1",
    "localforage": "^1.10.0",
    "lucide-react": "^0.460.0",
    "monaco-editor": "^0.56.0",
    "nanoid": "^3.3.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.11",
    "react-window": "^2.3.0",
    "three": "0.169.0",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.31",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/dompurify": "^3.0.5",
    "@types/jszip": "^3.4.1",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/react-window": "^2.0.0",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.0.0",
    "jsdom": "^25.0.0",
    "rimraf": "^6.0.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
