{
  "name": "@zeroexo/plugin-nodes",
  "version": "0.0.1",
  "description": "ZeroExo unified business node set (text/config/image/video/audio) with BaseNodeView shell + NodeShell pins",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@zeroexo/core": "workspace:*",
    "@zeroexo/plugin-ai-provider": "workspace:*",
    "@zeroexo/plugin-connection": "workspace:*",
    "@zeroexo/plugin-node-registry": "workspace:*",
    "@zeroexo/plugin-persistence": "workspace:*",
    "@zeroexo/plugin-render-react": "workspace:*",
    "@zeroexo/plugin-theme": "workspace:*",
    "@zeroexo/shared": "workspace:*",
    "antd": "^6.5.1",
    "lucide-react": "^0.469.0",
    "wavesurfer.js": "^7.12.11"
  },
  "peerDependencies": {
    "i18next": "^26.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-i18next": "^17.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "i18next": "^26.3.4",
    "react": "^18.3.1",
    "react-i18next": "^17.0.8",
    "rimraf": "^6.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
