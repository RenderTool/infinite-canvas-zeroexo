{
  "name": "@zeroexo/plugin-group",
  "version": "0.0.1",
  "description": "ZeroExo group plugin (strict tree hierarchy + scene graph + layout units)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@zeroexo/core": "workspace:*",
    "@zeroexo/shared": "workspace:*",
    "@zeroexo/plugin-render-react": "workspace:*",
    "@zeroexo/plugin-interaction": "workspace:*",
    "@zeroexo/plugin-selection": "workspace:*",
    "@zeroexo/plugin-history": "workspace:*",
    "@zeroexo/plugin-keyboard": "workspace:*",
    "lucide-react": "^0.469.0",
    "react-i18next": "^17.0.0"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0",
    "rimraf": "^6.0.0"
  }
}
